# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://prvision_hrms_app:YOUR_PASSWORD@pr-vision-hrms.kelhg3y.mongodb.net/pr_vision_hrms?retryWrites=true&w=majority&appName=PR-VISION-HRMS
MONGODB_DB_NAME=pr_vision_hrms

# MongoDB Connection Pool & Timeout Configuration
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20
DB_SERVER_SELECTION_TIMEOUT_MS=25000
DB_CONNECT_TIMEOUT_MS=25000
DB_SOCKET_TIMEOUT_MS=45000
DB_MAX_IDLE_TIME_MS=60000
DB_RECONNECT_INTERVAL_MS=10000
DB_MAX_RECONNECT_ATTEMPTS=12

# Controlled Index Synchronization (set true only when intentionally creating new schema indexes)
SYNC_INDEXES=false

JWT_ACCESS_SECRET=pr_vision_hrms_super_secure_access_secret_2026_jwt
JWT_REFRESH_SECRET=pr_vision_hrms_super_secure_refresh_secret_2026_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=pr_vision_cookie_secret_key_hrms_2026
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Development Admin Seed Configuration (LOCAL DEVELOPMENT ONLY)
DEV_ADMIN_SEED_ENABLED=true
DEV_ADMIN_EMAIL=admin@prvision.com
DEV_ADMIN_PASSWORD=Password@123
DEV_ADMIN_NAME=PR VISION Admin
